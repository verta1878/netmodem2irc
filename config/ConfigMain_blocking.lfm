        OnClick = btnBLMoveUpClick
      end
      object btnBLMoveDown: TButton
        Left = 300
        Top = 238
        Width = 55
        Height = 25
        Caption = 'Down'
        OnClick = btnBLMoveDownClick
      end
      object lblBLDefault: TLabel
        Left = 8
