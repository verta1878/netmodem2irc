      end
      object lvBlockList: TListView
        Left = 8
        Top = 28
        Width = 365
        Height = 200
        Columns = <
          item
            Caption = 'Action'
            Width = 65
          end
          item
            Caption = 'Pattern'
            Width = 120
          end
          item
            Caption = 'Forward To'
            Width = 100
          end
          item
            Caption = 'Comment'
            Width = 75
          end
        >
        ReadOnly = True
        RowSelect = True
        ViewStyle = vsReport
      end
      object btnBLAdd: TButton
        Left = 8
        Top = 238
        Width = 65
        Height = 25
        Caption = 'Add...'
        OnClick = btnBLAddClick
      end
      object btnBLEdit: TButton
        Left = 80
        Top = 238
        Width = 65
        Height = 25
        Caption = 'Edit...'
        OnClick = btnBLEditClick
      end
      object btnBLDelete: TButton
        Left = 152
        Top = 238
        Width = 65
        Height = 25
